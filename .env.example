# COSKA Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================
# NEBIUS TOKEN FACTORY (Required for real AI integration)
# Get your API key from: https://tokenfactory.nebius.com/
# ============================================================
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ============================================================
# TAVILY WEB RESEARCH (Required for external research)
# Get your API key from: https://tavily.com/
# ============================================================
TAVILY_API_KEY=

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///./coska.db

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================
# FRONTEND
# ============================================================
VITE_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173

# ============================================================
# SANDBOX SETTINGS
# Options: local, docker, auto
# - local: Local safe sandbox with containment (Windows development fallback)
# - docker: Isolated Docker sandbox (production/demo)
# - auto: Docker if available, otherwise local
# ============================================================
SANDBOX_MODE=local
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# AI PROVIDER SELECTION
# Options: mock, nebius, auto
# - mock: Uses mock provider for development/testing
# - nebius: Uses real Nebius Token Factory (requires NEBIUS_API_KEY)
# - auto: Uses nebius if key present, else mock
# ============================================================
AI_PROVIDER=mock
TAVILY_ENABLED=false

# ============================================================
# OPTIONAL: Production API Keys (leave empty for mock mode)
# ============================================================
NEBIUS_API_KEY=
TAVILY_API_KEY=